<odoo>
    <record id="view_move_form_extend" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_send_winbooks_email" string="Send to Multiple emails" type="object" class="oe_highlight"
                                invisible="not attachment_ids or move_type not in ('in_invoice', 'entry') " data-hotkey="r" />
            </xpath>
        </field>
    </record>
</odoo>
