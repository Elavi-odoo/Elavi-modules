<odoo>
    <record id="view_move_form_extend" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="has_invoice_attachments" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="after">
                <button name="action_send_winbooks_email"
                        string="Send To Multi Emails"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('move_type', 'not in', ('in_invoice',)), ('has_invoice_attachments', '=', False)]}"
                        data-hotkey="r" />
            </xpath>
        </field>
    </record>
</odoo>
