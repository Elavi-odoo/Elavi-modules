<odoo>
    <record id="view_account_journal_form_inherit_email" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.email</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group/group[@groups='account.group_account_manager']" position="after">
                <group string="Configure emails" invisible="not winbooks_integration_enabled">
                    <field name="WinBooks_email"/>
                    <field name="winbooks_integration_enabled" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
