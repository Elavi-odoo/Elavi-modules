<odoo>
    <record id="res_config_settings_view_form_inherit_winbooks" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.winbooks</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="101"/>
        <field name="inherit_id" ref="snailmail_account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <widget name="iap_buy_more_credits" service_name="snailmail" position="after">
                <div class="mt16">
                    <div>
                        <field name="enable_winbooks_integration"/>
                        <label for="enable_winbooks_integration" string="Enable WinBooks Integration"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."/>
                    </div>
                </div>
            </widget>
        </field>
    </record>
</odoo>
